{#
 luci-theme-office — login page
 Licensed to the public under the Apache License 2.0.
-#}

{% include('header', { blank_page: true }) %}

{% const board = ubus.call('system', 'board') ?? {}; %}

<main class="o-login">
	<div class="o-login-brand">
		<span class="o-the">THE</span>
		<span class="o-host">{{ striptags(board.hostname ?? 'OpenWrt') }}</span>
		<p class="o-desc">{{ board.model ?? 'OpenWrt' }} · {{ board.release?.description ?? '' }}</p>
	</div>

	<form method="post" class="o-card o-login-card">
		<span class="o-k">{{ _('Authorization Required') }}</span>
		<h2>{{ _('Log in') }}</h2>
		<p class="o-login-d">{{ _('Please enter your username and password.') }}</p>

		{% if (fuser): %}
		<div class="alert-message error">{{ _('Invalid username and/or password! Please try again.') }}</div>
		{% endif %}

		<label for="luci_username">{{ _('Username') }}</label>
		<input name="luci_username" id="luci_username" type="text" autocomplete="username" value="{{ entityencode(duser, true) }}">
		<label for="luci_password">{{ _('Password') }}</label>
		<input name="luci_password" id="luci_password" type="password" autocomplete="current-password">

		<button type="submit" class="btn o-login-btn">{{ _('Log in') }}</button>
	</form>

	<ul class="o-card o-steps o-login-steps" aria-hidden="true">
		<li><span class="n" style="--c:#7aa2ff">1</span>Research</li>
		<li><span class="n" style="--c:#a78bfa">2</span>Design</li>
		<li><span class="n" style="--c:#5df2a0">3</span>Engineering</li>
		<li class="hot"><span class="n">4</span>Operations</li>
		<li><span class="n" style="--c:#8a8fa8">5</span>Management</li>
	</ul>
</main>

<script>
	(function() {
		var form = document.querySelector('.o-login-card');
		var pw = document.getElementById('luci_password');
		if (pw) pw.focus();
		form.addEventListener('submit', function() {
			var b = form.querySelector('button');
			b.disabled = true;
			b.classList.add('spinning');
		});
	})();
</script>

{% include('footer', { blank_page: true }) %}
